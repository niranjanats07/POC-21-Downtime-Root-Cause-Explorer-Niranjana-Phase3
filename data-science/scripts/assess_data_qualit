
import csv
import hashlib
import json
import re
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
CSV_PATH = ROOT / "data/canonical/intelligence_data.csv"
MANIFEST_PATH = ROOT / "data/manifest.json"
OUTPUT_PATH = ROOT / "data-science/outputs/quality_assessment.json"

EMAIL_PATTERN = re.compile(
    r"\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b",
    re.IGNORECASE,
)

IP_PATTERN = re.compile(
    r"\b(?:\d{1,3}\.){3}\d{1,3}\b"
)

PHONE_PATTERN = re.compile(
    r"(?<!\w)(?:\+?\d[\d\s().-]{8,}\d)(?!\w)"
)


def load_json(path):
    with path.open("r", encoding="utf-8") as file:
        return json.load(file)


def sha256_file(path):
    digest = hashlib.sha256()

    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(65536), b""):
            digest.update(chunk)

    return digest.hexdigest()


def parse_timestamp(value):
    try:
        return datetime.fromisoformat(
            value.strip().replace("Z", "+00:00")
        )
    except (ValueError, TypeError, AttributeError):
        return None


def normalize_boolean(value):
    return str(value or "").strip().lower()


def get_distinct_non_empty(rows, field):
    return {
        row.get(field, "").strip()
        for row in rows
        if row.get(field, "").strip()
    }


def main():
    if not CSV_PATH.exists():
        raise FileNotFoundError(
            f"Canonical CSV not found: {CSV_PATH}"
        )

    if not MANIFEST_PATH.exists():
        raise FileNotFoundError(
            f"Manifest not found: {MANIFEST_PATH}"
        )

    with CSV_PATH.open(
        "r",
        encoding="utf-8-sig",
        newline=""
    ) as file:
        reader = csv.DictReader(file)
        rows = list(reader)
        columns = reader.fieldnames or []

    if not rows:
        raise ValueError("Canonical CSV is empty.")

    checks = []
    warnings = []

    def add_check(
        name,
        passed,
        detail,
        severity="blocking"
    ):
        checks.append(
            {
                "check": name,
                "status": "pass" if passed else "fail",
                "severity": severity,
                "detail": detail,
            }
        )

    # ------------------------------------------------------------------
    # Dataset structure
    # ------------------------------------------------------------------

    measurement_row_count = len(rows)

    source_incident_ids = get_distinct_non_empty(
        rows,
        "source_record_id"
    )

    distinct_source_incident_count = len(
        source_incident_ids
    )

    synthetic_incident_ids = {
        row.get("source_record_id", "").strip()
        for row in rows
        if row.get("source_record_id", "").strip()
        and normalize_boolean(
            row.get("is_synthetic", "")
        ) == "true"
    }

    real_incident_ids = {
        row.get("source_record_id", "").strip()
        for row in rows
        if row.get("source_record_id", "").strip()
        and normalize_boolean(
            row.get("is_synthetic", "")
        ) != "true"
    }

    synthetic_incident_count = len(
        synthetic_incident_ids
    )

    real_incident_count = len(
        real_incident_ids
    )

    distinct_machine_count = len(
        get_distinct_non_empty(rows, "entity_id")
    )

    rows_per_incident = Counter(
        row.get("source_record_id", "").strip()
        for row in rows
        if row.get("source_record_id", "").strip()
    )

    repeated_incident_measurement_rows = sum(
        max(count - 1, 0)
        for count in rows_per_incident.values()
    )

    # ------------------------------------------------------------------
    # Required identifiers and provenance
    # ------------------------------------------------------------------

    required_fields = [
        "record_id",
        "record_type",
        "observed_at",
        "entity_id",
        "source_name",
        "source_record_id",
        "is_synthetic",
        "data_version",
    ]

    missing_columns = [
        field
        for field in required_fields
        if field not in columns
    ]

    add_check(
        "required_columns",
        not missing_columns,
        f"Missing columns: {missing_columns}",
    )

    missing_values = {
        field: sum(
            not row.get(field, "").strip()
            for row in rows
        )
        for field in required_fields
        if field in columns
    }

    empty_required = {
        field: count
        for field, count in missing_values.items()
        if count > 0
    }

    add_check(
        "required_field_completeness",
        not empty_required,
        f"Empty required-field counts: {empty_required}",
    )

    # ------------------------------------------------------------------
    # Record identifier uniqueness
    # ------------------------------------------------------------------

    record_ids = [
        row.get("record_id", "").strip()
        for row in rows
    ]

    duplicate_ids = [
        value
        for value, count in Counter(record_ids).items()
        if value and count > 1
    ]

    add_check(
        "record_id_uniqueness",
        len(duplicate_ids) == 0 and all(record_ids),
        f"Duplicate IDs: {duplicate_ids}",
    )

    # ------------------------------------------------------------------
    # Numeric metric validity
    # ------------------------------------------------------------------

    invalid_metrics = []

    for index, row in enumerate(rows, start=2):
        try:
            value = float(
                row.get("metric_value", "")
            )

            if (
                value < 0
                or value != value
                or value in (
                    float("inf"),
                    float("-inf"),
                )
            ):
                raise ValueError()

        except (ValueError, TypeError):
            invalid_metrics.append(index)

    add_check(
        "metric_numeric_validity",
        not invalid_metrics,
        (
            "Invalid or negative metric values "
            f"at CSV rows: {invalid_metrics}"
        ),
    )

    # ------------------------------------------------------------------
    # Timestamp validity and timezone consistency
    # ------------------------------------------------------------------

    parsed_timestamps = []
    invalid_dates = []

    for index, row in enumerate(rows, start=2):
        parsed = parse_timestamp(
            row.get("observed_at", "")
        )

        if parsed is None:
            invalid_dates.append(index)
        else:
            parsed_timestamps.append(parsed)

    add_check(
        "observed_at_validity",
        not invalid_dates,
        f"Invalid timestamps at CSV rows: {invalid_dates}",
    )

    timezone_types = Counter(
        (
            "timezone-aware"
            if value.tzinfo is not None
            else "timezone-naive"
        )
        for value in parsed_timestamps
    )

    timezone_consistent = len(timezone_types) <= 1

    add_check(
        "timestamp_timezone_consistency",
        timezone_consistent,
        (
            "Timezone type distribution: "
            f"{dict(timezone_types)}"
        ),
        severity="warning",
    )

    # ------------------------------------------------------------------
    # Coordinate validity and pairing
    # ------------------------------------------------------------------

    coordinate_errors = []

    for index, row in enumerate(rows, start=2):
        lat = row.get("latitude", "").strip()
        lon = row.get("longitude", "").strip()

        if bool(lat) != bool(lon):
            coordinate_errors.append(
                f"Row {index}: unpaired coordinates"
            )
            continue

        if lat and lon:
            try:
                latitude = float(lat)
                longitude = float(lon)

                if not (
                    -90 <= latitude <= 90
                    and -180 <= longitude <= 180
                ):
                    coordinate_errors.append(
                        f"Row {index}: out-of-range coordinates"
                    )

            except ValueError:
                coordinate_errors.append(
                    f"Row {index}: non-numeric coordinates"
                )

    add_check(
        "coordinate_validity",
        not coordinate_errors,
        f"Coordinate issues: {coordinate_errors}",
        severity="warning",
    )

    # ------------------------------------------------------------------
    # Category and controlled values
    # ------------------------------------------------------------------

    for field in (
        "status",
        "category",
        "shift",
        "severity",
        "metric_unit",
    ):
        if field not in columns:
            continue

        values = [
            row.get(field, "").strip()
            for row in rows
        ]

        blank_count = sum(
            not value
            for value in values
        )

        add_check(
            f"{field}_completeness",
            blank_count == 0,
            f"Blank values: {blank_count}",
            severity="warning",
        )

        if any(
            value != value.lower()
            for value in values
            if value
        ):
            warnings.append(
                f"{field} contains mixed letter casing; "
                "verify controlled vocabulary."
            )

    # ------------------------------------------------------------------
    # Metric-unit consistency
    # ------------------------------------------------------------------

    units_by_metric = {}

    for row in rows:
        metric_name = row.get(
            "metric_name",
            ""
        ).strip()

        metric_unit = row.get(
            "metric_unit",
            ""
        ).strip()

        units_by_metric.setdefault(
            metric_name,
            set(),
        ).add(metric_unit)

    mixed_units = {
        metric: sorted(units)
        for metric, units in units_by_metric.items()
        if len(units) > 1
    }

    add_check(
        "metric_unit_consistency",
        not mixed_units,
        f"Metrics with multiple units: {mixed_units}",
    )

    # ------------------------------------------------------------------
    # Provenance and synthetic status
    # ------------------------------------------------------------------

    synthetic_values = Counter(
        normalize_boolean(
            row.get("is_synthetic", "")
        )
        for row in rows
    )

    provenance_complete = all(
        row.get("source_name", "").strip()
        and row.get(
            "source_record_id",
            ""
        ).strip()
        and row.get(
            "data_version",
            ""
        ).strip()
        for row in rows
    )

    add_check(
        "provenance_completeness",
        provenance_complete,
        (
            "Each row must identify its source, "
            "source record and data version."
        ),
    )

    all_synthetic = (
        measurement_row_count > 0
        and all(
            normalize_boolean(
                row.get("is_synthetic", "")
            ) == "true"
            for row in rows
        )
    )

    add_check(
        "synthetic_data_disclosure",
        all_synthetic,
        (
            "Synthetic flag distribution: "
            f"{dict(synthetic_values)}"
        ),
        severity="warning",
    )

    # ------------------------------------------------------------------
    # Manifest consistency
    # ------------------------------------------------------------------

    manifest = load_json(MANIFEST_PATH)

    manifest_checks = {
        "canonical_record_count": measurement_row_count,
        "canonical_column_count": len(columns),
    }

    manifest_mismatches = {
        key: {
            "manifest": manifest.get(key),
            "actual": actual,
        }
        for key, actual in manifest_checks.items()
        if manifest.get(key) != actual
    }

    add_check(
        "manifest_row_and_column_counts",
        not manifest_mismatches,
        (
            "Manifest mismatches: "
            f"{manifest_mismatches}"
        ),
    )

    # ------------------------------------------------------------------
    # Safety: scan available field values
    # ------------------------------------------------------------------

    possible_sensitive_matches = []

    for index, row in enumerate(rows, start=2):
        for field, value in row.items():
            value = value or ""

            if EMAIL_PATTERN.search(value):
                possible_sensitive_matches.append(
                    {
                        "csv_row": index,
                        "field": field,
                        "pattern": "possible_email",
                    }
                )

            if IP_PATTERN.search(value):
                possible_sensitive_matches.append(
                    {
                        "csv_row": index,
                        "field": field,
                        "pattern": "possible_ip_address",
                    }
                )

            if PHONE_PATTERN.search(value):
                possible_sensitive_matches.append(
                    {
                        "csv_row": index,
                        "field": field,
                        "pattern": "possible_phone_number",
                    }
                )

    add_check(
        "sensitive_content_screening",
        not possible_sensitive_matches,
        {
            "possible_matches": possible_sensitive_matches,
            "method": (
                "Pattern-based screening of canonical "
                "CSV field values"
            ),
            "limitation": (
                "This automated screening is not a complete "
                "privacy, security or legal review."
            ),
        },
        severity="warning",
    )

    # ------------------------------------------------------------------
    # Reproducibility
    # ------------------------------------------------------------------

    source_hash_before = sha256_file(CSV_PATH)
    source_hash_after = sha256_file(CSV_PATH)

    fingerprint_stable = (
        source_hash_before == source_hash_after
    )

    add_check(
        "canonical_input_fingerprint_stability",
        fingerprint_stable,
        {
            "sha256_before": source_hash_before,
            "sha256_after": source_hash_after,
            "stable_during_assessment": fingerprint_stable,
        },
    )

    reproducibility = {
        "canonical_source": (
            "data/canonical/intelligence_data.csv"
        ),
        "canonical_sha256": source_hash_before,
        "assessment_uses_deterministic_checks": True,
        "input_fingerprint_stable_during_assessment": (
            fingerprint_stable
        ),
        "independent_repeat_run_comparison": (
            "Not established by this script; compare fingerprints "
            "and generated outputs across separate runs."
        ),
    }

    # ------------------------------------------------------------------
    # Timeliness
    # ------------------------------------------------------------------

    assessment_time = datetime.now(timezone.utc)

    normalized_timestamps = [
        (
            value.replace(tzinfo=timezone.utc)
            if value.tzinfo is None
            else value.astimezone(timezone.utc)
        )
        for value in parsed_timestamps
    ]

    latest_timestamp = (
        max(normalized_timestamps)
        if normalized_timestamps
        else None
    )

    age_days = (
        (assessment_time - latest_timestamp).days
        if latest_timestamp
        else None
    )

    timeliness = {
        "assessment_timestamp_utc": assessment_time.isoformat(),
        "latest_observation_timestamp_utc": (
            latest_timestamp.isoformat()
            if latest_timestamp
            else None
        ),
        "age_of_latest_observation_days": age_days,
        "interpretation": (
            "Observation vintage is historical relative to assessment date; "
            "the dataset is synthetic and does not establish current "
            "operational conditions."
            if age_days is not None
            else (
                "Timeliness cannot be assessed because "
                "no valid timestamps exist."
            )
        ),
    }

    add_check(
        "observation_timeliness_assessment",
        latest_timestamp is not None,
        timeliness,
        severity="warning",
    )

    # ------------------------------------------------------------------
    # Source accuracy
    # ------------------------------------------------------------------

    source_accuracy = {
        "status": "NOT_INDEPENDENTLY_VERIFIABLE",
        "evidence_available": (
            "Canonical source identifiers and provenance fields "
            "are present."
        ),
        "evidence_missing": (
            "No authoritative original-source sample or independent "
            "source reconciliation evidence is available to this script."
        ),
        "conclusion": (
            "Structural validity and provenance do not independently "
            "prove that recorded values accurately match their "
            "original source."
        ),
    }

    # ------------------------------------------------------------------
    # Explicit limitations and warnings
    # ------------------------------------------------------------------

    for field in (
        "related_entity_id",
        "stage",
        "latitude",
        "longitude",
    ):
        if (
            field in columns
            and all(
                not row.get(field, "").strip()
                for row in rows
            )
        ):
            warnings.append(
                f"{field} is empty for every row; "
                "confirm whether it is optional."
            )

    if (
        "status" in columns
        and all(
            row.get(
                "status",
                ""
            ).strip().lower() == "closed"
            for row in rows
        )
    ):
        warnings.append(
            "Only closed records are present; "
            "status comparison is unavailable."
        )

    if all_synthetic:
        warnings.append(
            "All records are synthetic; operational conclusions "
            "cannot be generalized."
        )

    warnings.append(
        "Source accuracy is not independently verified against "
        "an authoritative sample."
    )

    warnings.append(
        "Reproducibility fingerprint stability is checked within "
        "this run; a separate repeat-run comparison is still required."
    )

    # ------------------------------------------------------------------
    # Blocking failures
    # ------------------------------------------------------------------

    blocking_failures = [
        check
        for check in checks
        if (
            check["status"] == "fail"
            and check["severity"] == "blocking"
        )
    ]

    # ------------------------------------------------------------------
    # Quality dimensions
    # ------------------------------------------------------------------

    if all_synthetic:
        representativeness_evidence = (
            f"{distinct_source_incident_count} distinct synthetic "
            f"incidents represented by {measurement_row_count} "
            "measurement rows."
        )
    else:
        representativeness_evidence = (
            f"{distinct_source_incident_count} distinct source incidents "
            f"represented by {measurement_row_count} measurement rows, "
            f"including {synthetic_incident_count} synthetic incidents "
            f"and {real_incident_count} non-synthetic incidents."
        )

    quality_dimensions = {
        "completeness": {
            "status": "ASSESSED",
            "evidence": (
                "Required-field completeness and field-specific checks."
            ),
        },
        "uniqueness": {
            "status": "ASSESSED",
            "evidence": (
                "Canonical record ID duplicate check."
            ),
        },
        "validity": {
            "status": "ASSESSED",
            "evidence": (
                "Numeric, timestamp and coordinate validity checks."
            ),
        },
        "consistency": {
            "status": "ASSESSED",
            "evidence": (
                "Metric-unit and timestamp timezone consistency checks."
            ),
        },
        "provenance": {
            "status": "ASSESSED",
            "evidence": (
                "Source, source-record and data-version completeness."
            ),
        },
        "safety": {
            "status": (
                "NO_PATTERN_MATCHES"
                if not possible_sensitive_matches
                else "REVIEW_REQUIRED"
            ),
            "evidence": (
                "Pattern-based scan for possible email, phone and IP values."
            ),
            "limitation": (
                "Not a complete privacy or security audit."
            ),
        },
        "reproducibility": {
            "status": (
                "INPUT_FINGERPRINT_STABLE"
                if fingerprint_stable
                else "FINGERPRINT_CHANGED"
            ),
            "evidence": reproducibility,
        },
        "timeliness": {
            "status": (
                "ASSESSED_HISTORICAL_VINTAGE"
                if latest_timestamp
                else "NOT_ASSESSABLE"
            ),
            "evidence": timeliness,
        },
        "source_accuracy": {
            "status": "NOT_INDEPENDENTLY_VERIFIABLE",
            "evidence": source_accuracy,
        },
        "representativeness": {
            "status": "LIMITED_SYNTHETIC_SAMPLE",
            "evidence": representativeness_evidence,
        },
    }

    # ------------------------------------------------------------------
    # Final result
    # ------------------------------------------------------------------

    result = {
        "source_file": (
            "data/canonical/intelligence_data.csv"
        ),
        "row_count": measurement_row_count,
        "column_count": len(columns),
        "canonical_sha256": source_hash_before,
        "dataset_structure": {
            "measurement_rows": measurement_row_count,
            "distinct_source_incidents": (
                distinct_source_incident_count
            ),
            "synthetic_incidents": (
                synthetic_incident_count
            ),
            "real_incidents": real_incident_count,
            "distinct_machines": distinct_machine_count,
            "repeated_source_incident_measurement_rows": (
                repeated_incident_measurement_rows
            ),
        },
        "quality_dimensions": quality_dimensions,
        "checks": checks,
        "warnings": warnings,
        "source_accuracy_assessment": source_accuracy,
        "timeliness_assessment": timeliness,
        "reproducibility_assessment": reproducibility,
        "blocking_failure_count": len(blocking_failures),
        "blocking_failures": blocking_failures,
        "assessment_status": (
            "BLOCKED"
            if blocking_failures
            else "NO_BLOCKING_FAILURES_DETECTED"
        ),
        "scope_note": (
            "Automated checks assess structural and selected content quality. "
            "They do not independently establish source accuracy, privacy "
            "compliance, operational representativeness or current "
            "operational conditions. Independent repeat-run comparison is "
            "still required to establish end-to-end reproducibility."
        ),
    }

    OUTPUT_PATH.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    OUTPUT_PATH.write_text(
        json.dumps(
            result,
            indent=2,
            ensure_ascii=False,
        ),
        encoding="utf-8",
    )

    print(
        f"Quality assessment generated: {OUTPUT_PATH}"
    )
    print(f"Measurement rows: {measurement_row_count}")
    print(
        f"Distinct source incidents: "
        f"{distinct_source_incident_count}"
    )
    print(
        f"Synthetic incidents: "
        f"{synthetic_incident_count}"
    )
    print(
        f"Distinct machines: "
        f"{distinct_machine_count}"
    )
    print(f"Checks: {len(checks)}")
    print(
        f"Blocking failures: "
        f"{len(blocking_failures)}"
    )
    print(
        f"Safety screening matches: "
        f"{len(possible_sensitive_matches)}"
    )
    print(
        f"Source accuracy: "
        f"{source_accuracy['status']}"
    )
    print(
        f"Latest observation age (days): "
        f"{age_days}"
    )
    print(
        f"Status: "
        f"{result['assessment_status']}"
    )


if __name__ == "__main__":
    main()
